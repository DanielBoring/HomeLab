# Environment files with secrets
.env
.env.local
.env.*.local
*.env.local

# SSL/TLS private keys and certificates
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer

# General secrets directory
secrets/

# Let's Encrypt certificate store (contains private keys)
acme.json

# SSH keys (no extension, won't match *.key)
id_rsa
id_ed25519
id_ecdsa
id_dsa

# Basic auth password files
*.htpasswd

# Database files
*.db
*.sqlite
*.sqlite3

# Local data directories (container runtime state copied locally)
data/

# Docker override files (may contain secrets)
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# Backup files
*.bak
*.backup
*.tmp
*.tar
*.tar.gz
*.tgz
*.zip
backups/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Log files that might contain secrets
*.log
logs/

# HTML guides (local reference only)
*.html

# AI assistant local/private files
.claude/
CLAUDE.md
.codex/
AGENTS.local.md
agents.local.md
.gemini/
GEMINI.md
