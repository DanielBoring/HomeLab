@@ -0,0 +1,72 @@
+import unittest
+from unittest.mock import patch
+
+from app.api import routes
+from app.models import AppConfig, DashboardGroup, FanConfig
+
+
+class DashboardReadingsTest(unittest.IsolatedAsyncioTestCase):
+    async def state(self, config, sensors, speeds):
+        original = config.model_dump()
+        with (
+            patch.object(routes, "_get_app_config", return_value=config),
+            patch.object(routes, "detect_sensors", return_value=sensors),
+            patch.object(routes, "get_fan_status", return_value=[]),
+            patch.object(routes.hwmon_pwm, "get_fan_rpm", side_effect=speeds.get),
+        ):
+            result = await routes.get_state()
+        self.assertEqual(config.model_dump(), original)
+        return result
+
+    async def test_cpu_and_unassigned_tachometers(self):
+        sensors = [
+            {"id": f"k10temp-hwmon12/{label}", "driver": "k10temp", "label": label, "current_temp": temp}
+            for label, temp in [("Tctl", 71.5), ("Tccd1", 55), ("Tccd2", 63)]
+        ]
+        result = await self.state(AppConfig(), sensors, {"hwmon-pwm-it87.2608/pwm3": 0})
+        cpu, = result["sensor_groups"]
+        self.assertEqual([s["alias"] for s in cpu["items"]],
+                         ["CPU control (Tctl)", "CPU chiplet 1 (CCD1)", "CPU chiplet 2 (CCD2)"])
+        self.assertEqual([s["temp"] for s in cpu["items"]], [71.5, 55, 63])
+        fans, = result["fan_groups"]
+        self.assertEqual([f["current_rpm"] for f in fans["items"]], [0, None])
+        self.assertEqual([f["label"] for f in fans["items"]], ["Small front fan", "CPU fan"])
+        self.assertTrue(all(f["last_percent"] is None for f in fans["items"]))
+
+    async def test_preserves_user_groups_and_configured_fans(self):
+        pwm = "hwmon-pwm-it87.2608/pwm"
+        sid = "k10temp-hwmon2/Tctl"
+        config = AppConfig(
+            dashboard_groups=[
+                DashboardGroup(id="cpu", name="My CPU", type="sensor", item_ids=[sid]),
+                DashboardGroup(id="fan", name="My RPM", type="fan", item_ids=[pwm + "3"]),
+            ],
+            fan_configs=[FanConfig(fan_id=pwm+"4", fan_label="My fan", backend="hwmon-pwm",
+                                   sensor_id=sid, curve_name="silent")],
+            sensor_aliases={sid: "CPU control"},
+        )
+        result = await self.state(config, [
+            {"id": sid, "driver": "k10temp", "label": "Tctl", "current_temp": 70}
+        ], {pwm+"3": 1010, pwm+"4": 1440})
+        cpu, = result["sensor_groups"]
+        reading, = cpu["items"]
+        self.assertEqual(reading["alias"], "CPU control")
+        group, = result["fan_groups"]
+        third, = group["items"]
+        fourth, = result["ungrouped_fans"]
+        self.assertEqual((group["name"], third["current_rpm"]), ("My RPM", 1010))
+        self.assertEqual((fourth["label"], fourth["current_rpm"]), ("My fan", 1440))
+
+    async def test_hdd_labels_use_persistent_ids_and_preserve_aliases(self):
+        ids = [f"drivetemp-wwid-naa.{wwid}/{model}" for wwid, model in (
+            ("5000cca0e7c0a989", "WDC WD200EDGZ-11"), ("5000cca2c7d5d067", "WDC WD200EDGZ-11"),
+            ("5000c500e929dd89", "ST20000DM001-3Y3"), ("5000cca2c7d5da25", "WDC WD200EDGZ-11"),
+            ("5000000000000000", "Unknown"),
+        )]
+        config = AppConfig(dashboard_groups=[DashboardGroup(id="hdd", name="HDD", type="sensor", item_ids=ids)],
+                           sensor_aliases={ids[3]: "My drive"})
+        result = await self.state(config, [], {})
+        cards = result["sensor_groups"][0]["items"]
+        self.assertEqual([s["alias"] for s in cards],
+                         ["WD 20 TB · A989", "WD 20 TB · D067", "Seagate 20 TB · DD89", "My drive", None])
+        self.assertTrue(all(s["temp"] is None for s in cards))
