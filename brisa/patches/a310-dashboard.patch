diff --git a/brisa/tests/test_arc_telemetry.py b/brisa/tests/test_arc_telemetry.py
new file mode 100644
index 0000000..c354a28
--- /dev/null
+++ b/brisa/tests/test_arc_telemetry.py
@@ -0,0 +1,69 @@
+import tempfile
+import unittest
+from pathlib import Path
+
+from app.arc_telemetry import read_arc
+
+
+class ArcTelemetryTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.root = Path(tmp.name)
+        self.gpu = self.root / "bus/pci/devices/0000:03:00.0"
+        self.chip = self.gpu / "hwmon/hwmon15"
+        self.chip.mkdir(parents=True)
+        (self.gpu / "vendor").write_text("0x8086")
+        (self.gpu / "device").write_text("0x56a6")
+        (self.chip / "name").write_text("i915")
+        (self.chip / "fan1_input").write_text("3119")
+
+    def telemetry(self, parent):
+        node = parent / "pmt/telem1"
+        node.mkdir(parents=True)
+        directory = self.root / "class/intel_pmt"
+        directory.mkdir(parents=True)
+        (directory / "telem1").symlink_to(node, target_is_directory=True)
+        (node / "guid").write_text("0x4f9502")
+        (node / "offset").write_text("0")
+        (node / "telem").write_bytes(bytes(56) + bytes([47, 60, 51, 0, 0, 0, 0, 0]))
+        return node
+
+    def test_independent_readings_and_zero_rpm(self):
+        self.assertEqual(read_arc(self.root), {"fan_rpm": 3119, "temperature_c": None})
+        (self.chip / "fan1_input").write_text("0")
+        self.assertEqual(read_arc(self.root)["fan_rpm"], 0)
+        self.telemetry(self.gpu)
+        self.assertEqual(read_arc(self.root)["temperature_c"], 47)
+        (self.chip / "fan1_input").unlink()
+        self.assertEqual(read_arc(self.root), {"fan_rpm": None, "temperature_c": 47})
+
+    def test_unknown_layout_and_short_read(self):
+        node = self.telemetry(self.gpu)
+        (node / "telem").write_bytes(bytes(56) + b"1")
+        self.assertIsNone(read_arc(self.root)["temperature_c"])
+        (node / "telem").write_bytes(bytes(64))
+        self.assertIsNone(read_arc(self.root)["temperature_c"])
+        (node / "telem").write_bytes(bytes([48]) * 64)
+        (node / "guid").write_text("0xffff")
+        self.assertIsNone(read_arc(self.root)["temperature_c"])
+
+    def test_other_device_and_disappearance(self):
+        self.telemetry(self.root / "another-device")
+        self.assertIsNone(read_arc(self.root)["temperature_c"])
+        (self.gpu / "device").unlink()
+        self.assertEqual(read_arc(self.root), {"temperature_c": None, "fan_rpm": None})
+
+    def test_labelled_gpu_temperature(self):
+        (self.chip / "temp1_label").write_text("GPU")
+        (self.chip / "temp1_input").write_text("42375")
+        self.assertEqual(read_arc(self.root)["temperature_c"], 42.375)
+
+    def test_i915_unlabelled_package_temperature(self):
+        (self.chip / "temp1_input").write_text("43000")
+        self.assertEqual(read_arc(self.root)["temperature_c"], 43)
+        (self.chip / "name").write_text("xe")
+        self.assertIsNone(read_arc(self.root)["temperature_c"])
+        (self.chip / "name").write_text("i915")
+        (self.chip / "temp1_label").write_text("memory")
+        self.assertIsNone(read_arc(self.root)["temperature_c"])
