diff --git a/brisa/app/arc_telemetry.py b/brisa/app/arc_telemetry.py
new file mode 100644
index 0000000..87ba6aa
--- /dev/null
+++ b/brisa/app/arc_telemetry.py
@@ -0,0 +1,69 @@
+"""Display-only readings for a single Intel Arc A310. Values are never cached."""
+
+from pathlib import Path
+
+
+# Intel compute-runtime's DG2 guidToKeyOffsetMap specifies SOC_TEMPERATURES at
+# byte 56. getGpuMaxTemperature() takes its low byte (GT temperature in C).
+DG2_LAYOUTS = {0x4F95, 0x4F9301, 0x4F9302, 0x4F9502}
+
+
+def _text(path):
+    try:
+        return path.read_text().strip()
+    except OSError:
+        return ""
+
+
+def _number(path):
+    try:
+        return int(_text(path), 0)
+    except ValueError:
+        return None
+
+
+def _pmt_temperature(gpu, root):
+    readings = []
+    for node in (root / "class/intel_pmt").glob("telem*"):
+        # Never borrow telemetry from a different card or an ambiguous bridge.
+        if gpu not in node.resolve().parents or _number(node / "guid") not in DG2_LAYOUTS:
+            continue
+        if _number(node / "offset") != 0:
+            continue  # Support only the zero-offset layout in this prototype.
+        try:
+            with (node / "telem").open("rb", buffering=0) as stream:
+                stream.seek(56)
+                data = stream.read(8)
+        except OSError:
+            continue
+        if len(data) == 8 and 0 < data[0] < 125:
+            readings.append(data[0])
+    return readings[0] if len(readings) == 1 else None
+
+
+def read_arc(root=Path("/sys")):
+    result = {"temperature_c": None, "fan_rpm": None}
+    devices = [dev for dev in (root / "bus/pci/devices").glob("*")
+               if _text(dev / "vendor") == "0x8086" and _text(dev / "device") == "0x56a6"]
+    if len(devices) != 1:
+        return result
+    gpu = devices[0].resolve()
+    for chip in (gpu / "hwmon").glob("hwmon*"):
+        driver = _text(chip / "name")
+        if driver not in {"i915", "xe"}:
+            continue
+        rpm = _number(chip / "fan1_input")
+        if rpm is not None and rpm >= 0:
+            result["fan_rpm"] = rpm
+        for sensor in sorted(chip.glob("temp*_input")):
+            label = _text(sensor.with_name(sensor.name.replace("_input", "_label"))).lower()
+            # i915 defines temp1_input as its GPU package reading even without a label.
+            package = driver == "i915" and sensor.name == "temp1_input" and not label
+            if package or label in {"gpu", "gt", "gpu temperature"}:
+                raw = _number(sensor)
+                if raw is not None and 0 < raw < 125000:
+                    result["temperature_c"] = raw / 1000
+                    break
+    if result["temperature_c"] is None:
+        result["temperature_c"] = _pmt_temperature(gpu, root)
+    return result
