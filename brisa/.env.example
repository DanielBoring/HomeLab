# Copy to .env for CLI use, or enter these as Portainer stack variables.
TZ=America/New_York
BRISA_DOMAIN=brisa.example.com

# Direct access on the TrueNAS LAN address.
BRISA_BIND_IP=10.0.5.10
BRISA_PORT=9595

# Absolute path on the TrueNAS Docker host; the directory must already exist.
BRISA_DATA_PATH=/mnt/SSD/Containers/brisa

# The image is pinned directly in compose.yaml. Review changes before upgrading.
