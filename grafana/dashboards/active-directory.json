        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (host) (windows_service_state{host=~\"$host\",name=~\"NTDS|DNS|DFSR|Netlogon|Kdc|ADWS\",state=\"running\"})",
          "instant": true,
          "legendFormat": "{{host}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Core AD services running (of 6)",
      "type": "stat",
      "description": "Counts NTDS, DNS, DFSR, Netlogon, Kdc, and ADWS in the Running state. Good: 6. Warning: 5. Bad: fewer than 5. A stopped service can break authentication, name resolution, replication, or management."
    },
