          "instant": true,
          "legendFormat": "{{host}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Clock offset",
      "type": "stat",
      "description": "Absolute Windows time offset from the configured time source. Good: under 100 ms. Warning: 100-300 ms. Bad: over 300 ms. Accurate time is essential for Kerberos; offsets approaching five minutes can cause authentication failures."
    },
