# Gitea - self-hosted Git service
#
# Copy this file to .env before deploying with Docker Compose, or add these
# values as Portainer stack environment variables.  Do not commit .env.

# PostgreSQL password for the gitea database user.
GITEA_DB_PASSWORD=replace-with-a-long-random-password

# Generate: openssl rand -hex 32
GITEA_SECRET_KEY=replace-with-64-random-hex-characters

# Generate: openssl rand -hex 64
GITEA_INTERNAL_TOKEN=replace-with-128-random-hex-characters

# DNS name routed by Traefik. Create a local-DNS record for this host.
GITEA_DOMAIN=gitea.virtuallyboring.com

# Confirmed unused by the currently running Docker containers on TrueNAS.
# This is published directly for Git-over-SSH; Traefik does not proxy SSH.
GITEA_SSH_PORT=2222

# Do not allow unauthenticated LAN users to create accounts.
GITEA_DISABLE_REGISTRATION=true

# Match the ownership used by the existing TrueNAS Compose stacks.
PUID=3001
PGID=3001
TZ=America/New_York
