# Bambu Buddy on TrueNAS, deployed by Portainer.
# Copy to .env for a CLI deployment, or set these as Portainer stack variables.
# Do not commit the resulting .env file.

# DNS name routed by Traefik. Create a LAN DNS record pointing at Traefik.
BAMBUDDY_DOMAIN=bambuddy.virtuallyboring.com

# Pin to a reviewed stable release; do not use a rolling latest tag in production.
BAMBUDDY_VERSION=v1.2.5.3

# Generate a Fernet-compatible key with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store the generated value only in Portainer or an uncommitted .env file.
BAMBUDDY_MFA_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Match the ownership used by the existing TrueNAS Compose stacks.
PUID=3001
PGID=3001
TZ=America/New_York

# Keep production logging at INFO unless troubleshooting.
BAMBUDDY_LOG_LEVEL=INFO
