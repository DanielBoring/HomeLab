# Printventory on TrueNAS, deployed by Portainer.
# Copy to .env for a CLI deployment, or set these as Portainer stack variables.
# Do not commit the resulting .env file.

# DNS name routed by Traefik. Create a LAN DNS record pointing at Traefik.
PRINTVENTORY_DOMAIN=printventory.virtuallyboring.com

# Pin to a reviewed release; do not use the rolling latest tag in production.
PRINTVENTORY_VERSION=2.2.22

# Host directory holding your 3D model library (STL/3MF/OBJ/STEP...).
# Mounted read-only at /mnt/models inside the container.
PRINTVENTORY_MODELS_PATH=/mnt/Data/Media/STLs

# Optional: comma-separated container paths to skip during scans.
# Example: /mnt/models/cache,/mnt/models/derivatives
PRINTVENTORY_STL_HOME_EXCLUDE=

# Container memory cap. 4g suits large libraries; 2g is fine for small ones.
PRINTVENTORY_MEM_LIMIT=4g

# Thumbnail renderer backend: swiftshader (CPU), auto, or nvidia (needs GPU passthrough).
PRINTVENTORY_GPU=swiftshader

# 3MF preview worker limits. Keep worker memory well below PRINTVENTORY_MEM_LIMIT.
PRINTVENTORY_PREVIEW_3MF_WORKER_MEMORY_MB=512
PRINTVENTORY_PREVIEW_3MF_MAX_FILE_SIZE_MB=200

TZ=America/New_York
