# SearXNG — Private Metasearch Engine
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it contains secrets.

# ─── Domain ───────────────────────────────────────────────────────────────────

# Hostname Traefik routes to SearXNG
SEARXNG_DOMAIN=searxng.yourdomain.com

# ─── Ports ────────────────────────────────────────────────────────────────────

# Host port for direct access (optional — Traefik is the primary entrypoint)
SEARXNG_PORT=8092

# ─── System ───────────────────────────────────────────────────────────────────

TZ=America/New_York
